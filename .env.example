# ── Copia este archivo como .env y rellénalo ──────────────────────────────

# ── Cerebro (IA) ──────────────────────────────────────────────────────────
# gemini (recomendado, gratis) | groq | openrouter | ollama | anthropic | openai
V_PROVIDER=gemini
# Clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Vacío = modelo por defecto (gemini-3.8-flash). Ej.: gemini-3.5-flash-lite
V_MODEL=

# Respaldo automático si se agota la cuota gratuita (opcional), p. ej. groq
V_FALLBACK=
# https://console.groq.com/keys (gratis)
GROQ_API_KEY=
# https://openrouter.ai/keys (modelos gratuitos)
OPENROUTER_API_KEY=
# Claude, de pago (opcional)
ANTHROPIC_API_KEY=
# IA local y privada con Ollama (opcional)
OLLAMA_URL=http://localhost:11434/v1

# ── Tú y la voz de V ──────────────────────────────────────────────────────
# Cómo te llama V
V_OWNER_NAME=
# Voces: python -m v voces  (Jorge-MX, Álvaro-ES, Tomás-AR, Dalia-MX, Elvira-ES…)
V_VOICE=es-MX-JorgeNeural
V_VOICE_RATE=+0%
V_LANG=es-MX

# ── Seguridad ─────────────────────────────────────────────────────────────
# Qué acciones piden tu permiso: sensibles (recomendado) | todo | nada
V_CONFIRM=sensibles
# Permitir que V ejecute comandos de terminal (siempre pide permiso)
V_ALLOW_SHELL=false

# ── Garmin Connect ────────────────────────────────────────────────────────
# Mejor usa `python -m v garmin`: guarda la sesión, no la contraseña.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# ── Red ───────────────────────────────────────────────────────────────────
V_HOST=127.0.0.1
V_PORT=8000
# Tu dirección HTTPS para el iPhone (Tailscale o Cloudflare), para el QR
V_PUBLIC_URL=
